# Server Configuration
PORT=3000
NODE_ENV=development

# NUVEI (BaseCommerce/BaseX) API Configuration
# This account's gateway is BaseCommerce's proprietary 3DES-encrypted API,
# not Nuvei's REST 1.0 API and not NMI. All three credentials below are
# required together — get them from BaseCommerce/Nuvei's "Merchant
# Information" panel for this account.
# NUVEI_SANDBOX_MODE: true = https://gateway.basecommercesandbox.com,
#   false = https://gateway.basecommerce.com (production). Leave
#   NUVEI_API_ENDPOINT blank to auto-select by this flag.
NUVEI_SDK_USERNAME=your_basecommerce_sdk_username
NUVEI_SDK_PASSWORD=your_basecommerce_sdk_password
NUVEI_SDK_KEY=your_basecommerce_sdk_key
NUVEI_ORGANIZATION_ID=
NUVEI_SANDBOX_MODE=true
NUVEI_API_ENDPOINT=

# BaseCommerce SANDBOX credentials. The sandbox is a separate merchant account
# from production with its own credential triple — the production values above
# will NOT authenticate against gateway.basecommercesandbox.com. Required for
# any /ghl-provider/charge that resolves to test mode.
NUVEI_SDK_USERNAME_TEST=your_basecommerce_sandbox_sdk_username
NUVEI_SDK_PASSWORD_TEST=your_basecommerce_sandbox_sdk_password
NUVEI_SDK_KEY_TEST=your_basecommerce_sandbox_sdk_key

# GoHighLevel (GHL) Custom App / Private Integration Configuration
# GHL_LOCATION_ID: Your sub-account Location ID (Settings > Business Profile)
# GHL_API_TOKEN: Private Integration Token (Settings > Integrations > Private Integrations > Create)
# GHL_USER_ID: (Optional) GHL user ID used when creating contact notes
GHL_LOCATION_ID=your_ghl_location_id
GHL_API_TOKEN=pit-your_private_integration_token_here
GHL_API_ENDPOINT=https://services.leadconnectorhq.com
GHL_USER_ID=your_ghl_user_id

# GHL Marketplace App (OAuth) — required for the Custom Payment Provider flow.
# Create the app at marketplace.gohighlevel.com; the client id/secret come from
# its "Auth" settings. GHL_OAUTH_REDIRECT_URI must exactly match the redirect
# URL registered on the app, and points at this service's /oauth/callback.
GHL_MARKETPLACE_CLIENT_ID=your_ghl_marketplace_client_id
GHL_MARKETPLACE_CLIENT_SECRET=your_ghl_marketplace_client_secret
GHL_OAUTH_REDIRECT_URI=https://am333-nuvei-production.up.railway.app/oauth/callback

# GHL Custom Payment Provider keys, printed once by
# `node scripts/register-ghl-provider.js` — GHL never returns them again, so
# copy them out of that run's output and store them here.
#   *_API_KEY         — secret; GHL sends it to /ghl-provider/query, which
#                       authenticates the call against these values.
#   *_PUBLISHABLE_KEY — not secret; GHL echoes it back to the checkout iframe in
#                       payment_initiate_props. /ghl-provider/charge compares
#                       against these to decide live vs. test (GHL's own `mode`
#                       field is "payment", not a live/test signal). An
#                       unrecognised key fails closed to test.
GHL_PROVIDER_LIVE_API_KEY=
GHL_PROVIDER_LIVE_PUBLISHABLE_KEY=
GHL_PROVIDER_TEST_API_KEY=
GHL_PROVIDER_TEST_PUBLISHABLE_KEY=

# Deployed app URL — read by scripts/register-ghl-provider.js to build the
# paymentsUrl / queryUrl / imageUrl submitted when registering this app as a
# GHL custom payment provider.
APP_URL=https://am333-nuvei-production.up.railway.app

# Direct payment links (/pay) — independent of the GHL Marketplace app, no
# OAuth or approval needed. PAYMENT_LINK_SECRET signs the amount/currency/
# description into every link generated by scripts/create-payment-link.js;
# generate with: openssl rand -hex 32
PAYMENT_LINK_SECRET=
# Comma-separated origins /pay is allowed to redirect a paying customer to
# after a charge (successUrl/failureUrl on the link) — add your real site's
# origin(s) here, e.g. https://amwellinc.com
PAYMENT_LINK_ALLOWED_REDIRECT_ORIGINS=

# Railway-specific Configuration (leave empty for local dev)
DATABASE_URL=
LOG_LEVEL=info
