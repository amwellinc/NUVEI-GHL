# Server Configuration
PORT=3000
NODE_ENV=development

# NUVEI API Configuration
NUVEI_MERCHANT_ID=your_merchant_id_here
NUVEI_SECRET_KEY=your_secret_key_here
NUVEI_API_ENDPOINT=https://secure.safecharge.com/api/v1
NUVEI_SANDBOX_MODE=true

# NUVEI SDK Credentials (Alternative authentication method)
NUVEI_SDK_USERNAME=your_sdk_username
NUVEI_SDK_PASSWORD=your_sdk_password
NUVEI_SDK_KEY=your_sdk_key_here

# GoHighLevel (GHL) Custom App / Private Integration Configuration
# GHL_LOCATION_ID: Your sub-account Location ID (Settings > Business Profile)
# GHL_API_TOKEN: Private Integration Token (Settings > Integrations > Private Integrations > Create)
# GHL_USER_ID: (Optional) GHL user ID used when creating contact notes
GHL_LOCATION_ID=your_ghl_location_id
GHL_API_TOKEN=pit-your_private_integration_token_here
GHL_API_ENDPOINT=https://services.leadconnectorhq.com
GHL_USER_ID=your_ghl_user_id

# Deployed app URL — used to build the payment redirect URL sent to GHL
APP_URL=https://am333-nuvei-ghl-production.up.railway.app

# Railway-specific Configuration (leave empty for local dev)
DATABASE_URL=
LOG_LEVEL=info
