# Server Configuration
PORT=3000
NODE_ENV=development

# NUVEI API Configuration
NUVEI_MERCHANT_ID=your_merchant_id_here
NUVEI_SECRET_KEY=your_secret_key_here
NUVEI_API_ENDPOINT=https://secure.safecharge.com/api/v1
NUVEI_SANDBOX_MODE=true

# NUVEI SDK Credentials (Alternative authentication method)
NUVEI_SDK_USERNAME=your_sdk_username
NUVEI_SDK_PASSWORD=your_sdk_password
NUVEI_SDK_KEY=your_sdk_key_here

# GoHighLevel (GHL) Configuration
GHL_LOCATION_ID=your_ghl_location_id
GHL_API_TOKEN=your_ghl_api_token
GHL_API_ENDPOINT=https://rest.gohighlevel.com/v1

# Railway-specific Configuration (leave empty for local dev)
DATABASE_URL=
LOG_LEVEL=info
