# Server Configuration
PORT=3000
NODE_ENV=development

# NUVEI (BaseCommerce/BaseX) API Configuration
# This account's gateway is BaseCommerce's proprietary 3DES-encrypted API,
# not Nuvei's REST 1.0 API and not NMI. All three credentials below are
# required together — get them from BaseCommerce/Nuvei's "Merchant
# Information" panel for this account.
# NUVEI_SANDBOX_MODE: true = https://gateway.basecommercesandbox.com,
#   false = https://gateway.basecommerce.com (production). Leave
#   NUVEI_API_ENDPOINT blank to auto-select by this flag.
NUVEI_SDK_USERNAME=your_basecommerce_sdk_username
NUVEI_SDK_PASSWORD=your_basecommerce_sdk_password
NUVEI_SDK_KEY=your_basecommerce_sdk_key
NUVEI_ORGANIZATION_ID=
NUVEI_SANDBOX_MODE=true
NUVEI_API_ENDPOINT=

# GoHighLevel (GHL) Custom App / Private Integration Configuration
# GHL_LOCATION_ID: Your sub-account Location ID (Settings > Business Profile)
# GHL_API_TOKEN: Private Integration Token (Settings > Integrations > Private Integrations > Create)
# GHL_USER_ID: (Optional) GHL user ID used when creating contact notes
GHL_LOCATION_ID=your_ghl_location_id
GHL_API_TOKEN=pit-your_private_integration_token_here
GHL_API_ENDPOINT=https://services.leadconnectorhq.com
GHL_USER_ID=your_ghl_user_id

# Deployed app URL — used to build the payment redirect URL sent to GHL
APP_URL=https://am333-nuvei-ghl-production.up.railway.app

# Shared secret GHL's Custom Payment Provider config must send back on every
# call to /checkout, /query/:transactionId, and /webhook/payment-status
# (header: X-Provider-Secret). Generate with: openssl rand -hex 32
PAYMENT_PROVIDER_SHARED_SECRET=

# Railway-specific Configuration (leave empty for local dev)
DATABASE_URL=
LOG_LEVEL=info
